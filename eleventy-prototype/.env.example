# Copy to .env and fill in from your Tina Cloud project (see TINA-SETUP.md).
# .env is gitignored — never commit real values. The same two vars must also be
# set in the Cloudflare Pages project settings for production builds.

# Project → Overview → Client ID
TINA_PUBLIC_CLIENT_ID=

# Project → Tokens → a Read/Write content token
TINA_TOKEN=
