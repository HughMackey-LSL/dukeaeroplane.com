<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ headTitle or title }}</title>
  <meta name="description" content="{{ description }}">
  {%- if og %}
  <meta property="og:site_name" content="{{ og.site_name }}">
  <meta property="og:title" content="{{ og.title }}">
  <meta property="og:description" content="{{ og.description }}">
  <meta property="og:image" content="{{ og.image }}">
  <meta property="og:url" content="{{ og.url }}">
  {%- endif %}
  <link rel="icon" href="images/galenlogo4.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600&family=Josefin+Slab:wght@400;600;700&family=Quicksand:wght@400;500;600&family=Special+Elite&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css?v=12">
  <link rel="stylesheet" href="assets/extras.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {%- set ann = announcements.announcements | activeAnnouncement %}
  {%- if ann %}
  <div class="announce-bar" data-announce-id="{{ ann.id }}" role="region" aria-label="Announcement">
    <div class="announce-inner">
      <p class="announce-msg">{% if ann.url %}<a href="{{ ann.url }}">{{ ann.message }}</a>{% else %}{{ ann.message }}{% endif %}</p>
      <button class="announce-dismiss" type="button" aria-label="Dismiss announcement">&times;</button>
    </div>
  </div>
  {%- endif %}

  <header class="site-header">
    <a class="site-logo" href="index.html">
      <img src="images/galenlogo4.png" alt="Galen Cassidy Peria A.K.A. Duke Aeroplane">
    </a>
  </header>

  <nav class="site-nav" aria-label="Main">
    <div class="nav-inner">
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">Menu</button>
      <ul class="nav-menu" id="nav-menu">
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if item.url == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </nav>

  <main id="main">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">{{ site.copyright }}</div>
  </footer>

  <script src="js/main.js?v=11"></script>
  <script src="assets/announce.js" defer></script>
</body>
</html>
